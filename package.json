{
  "name": "tasks",
  "version": "9.0.0-SNAPSHOT",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.federation.config.mjs",
    "clean": "rm -rf dist/ src/main/resources/javascript/apps/",
    "dev": "vite build --watch",
    "dev:federation": "vite build --config vite.federation.config.mjs --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jahia/moonstone": "^2.20.3",
    "@jahia/moonstone-alpha": "^1.0.1",
    "@jahia/ui-extender": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jahia/javascript-modules-library": "^1.2.0",
    "@jahia/vite-federation-plugin": "^0.1.3",
    "@jahia/vite-plugin": "^1.2.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.14"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0"
  },
  "jahia": {
    "snapshot": true,
    "module-dependencies": "default",
    "module-type": "system",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets",
    "remotes": {
      "jahia": "javascript/apps/remoteEntry.js"
    }
  }
}
